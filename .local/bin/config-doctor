#!/bin/sh

set -eu

check_ai=0
case "${1:-}" in
    --ai) check_ai=1 ;;
    "") ;;
    *) printf 'usage: config-doctor [--ai]\n' >&2; exit 2 ;;
esac

home_git="${HOME_GIT_DIR:-$HOME/.cfg}"
home_work_tree="${HOME_WORK_TREE:-$HOME}"

detect_smb_remote() {
    if [ -n "${SMB_CONFIG_REMOTE:-}" ]; then
        printf '%s\n' "$SMB_CONFIG_REMOTE"
        return
    fi

    for mount_point in ${SMB_CONFIG_MOUNT_POINT:+"$SMB_CONFIG_MOUNT_POINT"} /Volumes/homes /mnt/katecloud/homes; do
        [ -d "$mount_point" ] 2>/dev/null || true
        if mount | grep -Fq " on $mount_point "; then
            printf '%s/repo/git/config.git\n' "$mount_point"
            return
        fi
    done
}

smb_remote="$(detect_smb_remote)"

ok() {
    printf 'ok: %s\n' "$1"
}

fail() {
    printf 'fail: %s\n' "$1" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

need git
need fish
need nvim
need starship

fish -n "$HOME/.config/fish/config.fish"
ok "fish syntax"

nvim --headless '+qa' >/dev/null 2>&1
ok "nvim startup"

starship print-config >/dev/null
ok "starship config"

test -f "$HOME/.config/kitty/kitty.conf" || fail "missing kitty.conf"
test -f "$HOME/.config/kitty/linux.conf" || fail "missing kitty linux.conf"
test -f "$HOME/.config/kitty/macos.conf" || fail "missing kitty macos.conf"
test -f "$HOME/.config/kitty/catppuccin-current.conf" || fail "missing kitty catppuccin-current.conf"
test -x "$HOME/.config/kitty/switch-catppuccin" || fail "switch-catppuccin is not executable"
ok "kitty files"

# Some tools rewrite tracked files on their own after checkout/first run
# (see AGENTS.md "background auto-injected diffs"). Flag known paths
# instead of letting a real edit and installer noise look the same.
hint_noisy_paths() {
    git --git-dir="$home_git" --work-tree="$home_work_tree" diff --name-only "$@" | while IFS= read -r path; do
        case "$path" in
            .profile|.zshrc|.config/opencode/opencode.json|.config/zed/settings.json)
                printf '  hint: %s is a known background-auto-injected path (see AGENTS.md) -- check the diff, or `home checkout -- %s` to discard\n' "$path" "$path" >&2
                ;;
        esac
    done
}

test -d "$home_git" || fail "missing bare repo: $home_git"
if ! git --git-dir="$home_git" --work-tree="$home_work_tree" diff --quiet; then
    hint_noisy_paths
    fail "home work tree has unstaged changes"
fi
if ! git --git-dir="$home_git" --work-tree="$home_work_tree" diff --cached --quiet; then
    hint_noisy_paths --cached
    fail "home index has staged changes"
fi
ok "home work tree clean"

head_ref=$(git --git-dir="$home_git" rev-parse HEAD)
# --verify --quiet keeps stdout empty when the ref is missing; plain rev-parse
# echoes the argument, which made a fresh `git clone --bare` (no remote-tracking
# refs yet) compare a commit hash against the literal ref name and fail.
origin_ref=$(git --git-dir="$home_git" rev-parse --verify --quiet refs/remotes/origin/main || true)
if [ -n "$origin_ref" ] && [ "$head_ref" != "$origin_ref" ]; then
    fail "HEAD differs from origin/main"
fi
ok "origin/main matches HEAD"

if [ -n "$smb_remote" ] && [ -d "$smb_remote" ]; then
    test -w "$smb_remote/objects" || fail "SMB mirror is not writable: $smb_remote"
    smb_ref=$(git -C "$smb_remote" rev-parse --verify --quiet refs/heads/main || true)
    if [ -z "$smb_ref" ] || [ "$head_ref" != "$smb_ref" ]; then
        fail "HEAD differs from SMB mirror"
    fi
    ok "SMB mirror matches HEAD"
else
    printf 'skip: SMB mirror not mounted or not configured\n'
fi

if [ "$check_ai" -eq 1 ]; then
    command -v setup-ai-env >/dev/null 2>&1 || fail "missing setup-ai-env"
    setup-ai-env --check || fail "AI environment incomplete (see docs/ai-environment.md)"
else
    printf 'skip: AI presence check is explicit (config-doctor --ai or setup-ai-env --check)\n'
fi
